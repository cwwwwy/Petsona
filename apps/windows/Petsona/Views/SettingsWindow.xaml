<Window
    x:Class="Petsona.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Petsona 设置">

    <Grid>
        <Grid.Resources>
            <!-- Hand-written card look (no third-party toolkit, see settings-consolidation S04). -->
            <Style x:Key="SettingsCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>
            <Style x:Key="CardHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="CardDescriptionStyle" TargetType="TextBlock">
                <Setter Property="Opacity" Value="0.7" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Margin" Value="0,14,0,6" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Auto pane: full labels when wide, icon-only rail when narrow (REQ-S17). -->
        <NavigationView x:Name="RootPanel"
                        Grid.Row="0"
                        PaneDisplayMode="Auto"
                        CompactModeThresholdWidth="640"
                        ExpandedModeThresholdWidth="900"
                        IsPaneOpen="True"
                        OpenPaneLength="200"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        SelectionChanged="OnNavSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="宠物" Tag="pets" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Folder" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="外观与交互" Tag="appearance">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Font" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="说话方式" Tag="persona">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Contact" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="记忆" Tag="memory">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Clock" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="模型服务" Tag="deepseek">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="World" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="系统" Tag="startup">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <ScrollViewer Padding="24,16,24,16">
                <Grid MaxWidth="1000" MinWidth="560" HorizontalAlignment="Stretch">
                    <!-- ================================================== 宠物 -->
                    <StackPanel x:Name="PagePets" Spacing="6">
                        <TextBlock Text="宠物库" Style="{StaticResource SectionHeaderStyle}" />
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="本地宠物" Style="{StaticResource CardHeaderStyle}" />
                                <TextBlock Text="单击切换当前宠物；双击 Codex 候选可直接导入。V2 图集（8×11）支持方向姿势与更多动作。"
                                           Style="{StaticResource CardDescriptionStyle}" />
                                <ListView x:Name="PetList" MaxHeight="220" SelectionChanged="OnPetSelectionChanged">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <Image Width="48" Height="48" Source="{Binding Thumbnail}" />
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="导入…">
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="从文件夹导入…" Click="OnImportFolderClick" />
                                                <MenuFlyoutItem Text="从 zip 导入…" Click="OnImportArchiveClick" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                    <Button Content="导出…" Click="OnExportPetClick" />
                                    <Button Content="删除" Click="OnDeletePetClick" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="ConflictPanel" Style="{StaticResource SettingsCardStyle}" Visibility="Collapsed">
                            <StackPanel Spacing="8">
                                <TextBlock Text="导入冲突" Style="{StaticResource CardHeaderStyle}" />
                                <TextBlock x:Name="ConflictText" Style="{StaticResource CardDescriptionStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="覆盖导入" Click="OnOverwriteImportClick" />
                                    <Button Content="取消" Click="OnCancelConflictClick" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="从 Codex 导入" Style="{StaticResource SectionHeaderStyle}" />
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Codex 候选（双击导入）" Style="{StaticResource CardHeaderStyle}" />
                                <TextBlock Text="只读取 ~/.codex/pets 的候选列表；导入时才会复制到 Petsona 本地库，原目录不会被修改。"
                                           Style="{StaticResource CardDescriptionStyle}" />
                                <ListView x:Name="CodexList" MaxHeight="220" DoubleTapped="OnCodexDoubleTapped">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <Image Width="48" Height="48" Source="{Binding Thumbnail}" />
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="重新扫描" Click="OnScanCodexClick" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ========================================= 外观与交互 -->
                    <StackPanel x:Name="PageAppearance" Spacing="6" Visibility="Collapsed">
                        <TextBlock Text="窗口" Style="{StaticResource SectionHeaderStyle}" />
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="缩放" Style="{StaticResource CardHeaderStyle}" />
                                    <TextBlock Text="拖动调整宠物大小，按固定档位吸附（50%–200%）；托盘菜单与这里保持同一套档位。"
                                               Style="{StaticResource CardDescriptionStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <Slider x:Name="ScaleSlider" Width="220" Minimum="0.5" Maximum="2.0"
                                            StepFrequency="0.25" SnapsTo="StepValues"
                                            TickFrequency="0.25" TickPlacement="Outside"
                                            ValueChanged="OnScaleChanged" />
                                    <TextBlock x:Name="ScaleValueText" MinWidth="52" VerticalAlignment="Center"
                                               Style="{StaticResource CardDescriptionStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="像素级点击穿透" Style="{StaticResource CardHeaderStyle}" />
                                    <TextBlock Text="开启后，透明像素的点击会落到桌面，只有宠物身体的像素会拦截鼠标；拖动与设置不受影响。"
                                               Style="{StaticResource CardDescriptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" x:Name="ClickThroughToggle" VerticalAlignment="Center"
                                              Toggled="OnClickThroughToggled" />
                            </Grid>
                        </Border>
                        <TextBlock Text="空闲问候" Style="{StaticResource SectionHeaderStyle}" />
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="让宠物主动打招呼" Style="{StaticResource CardHeaderStyle}" />
                                    <TextBlock Text="一段时间没有操作后，宠物会用一句短问候冒泡；没有配置 DeepSeek 时使用人格里的固定问候。"
                                               Style="{StaticResource CardDescriptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" x:Name="GreetingEnabledToggle" VerticalAlignment="Center"
                                              />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="空闲时长（分钟）" Style="{StaticResource CardHeaderStyle}" />
                                    <TextBlock Text="连续多久没有点击 / 拖动 / 输入后触发问候。" Style="{StaticResource CardDescriptionStyle}" />
                                </StackPanel>
                                <NumberBox Grid.Column="1" x:Name="GreetingIdleMinutesBox" Minimum="1" Maximum="1440"
                                           MinWidth="120" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="问候冷却（分钟）" Style="{StaticResource CardHeaderStyle}" />
                                    <TextBlock Text="两次问候之间的最短间隔；0 表示不限制。" Style="{StaticResource CardDescriptionStyle}" />
                                </StackPanel>
                                <NumberBox Grid.Column="1" x:Name="GreetingCooldownBox" Minimum="0" Maximum="1440"
                                           MinWidth="120" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="固定问候文案" Style="{StaticResource CardHeaderStyle}" />
                                <TextBlock Text="没有配置 DeepSeek 时，空闲问候与失败回退都用这句话；留空则按时间自动选择。"
                                           Style="{StaticResource CardDescriptionStyle}" />
                                <TextBox x:Name="PersonaGreetingBox" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="问候最大字数" Style="{StaticResource CardHeaderStyle}" />
                                    <TextBlock Text="模型回复超过该长度会被截断；建议 20–40。" Style="{StaticResource CardDescriptionStyle}" />
                                </StackPanel>
                                <NumberBox Grid.Column="1" x:Name="GreetingMaxCharsBox" Minimum="1" Maximum="200"
                                           MinWidth="120" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ============================================== 说话方式 -->
                    <StackPanel x:Name="PagePersona" Spacing="6" Visibility="Collapsed">
                        <TextBlock Text="说话方式" Style="{StaticResource SectionHeaderStyle}" />
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="这只宠物的说话方式" Style="{StaticResource CardHeaderStyle}" />
                                <TextBlock Text="说话方式跟着宠物走：切换宠物就是切换语气与提示词。记忆、模型服务在各自页面配置。"
                                           Style="{StaticResource CardDescriptionStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="导入…" Click="OnImportPersonaClick" />
                                    <Button Content="导出…" Click="OnExportPersonaClick" />
                                    <Button Content="重置为内置" Click="OnResetPersonaClick" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="语气" Style="{StaticResource CardHeaderStyle}" />
                                <TextBlock Text="选一个预设，或直接改成自己的说法；预设同时决定回答的长短。" Style="{StaticResource CardDescriptionStyle}" />
                                <ComboBox x:Name="PersonaTonePresetCombo" MinWidth="220" HorizontalAlignment="Left"
                                          SelectionChanged="OnPersonaTonePresetChanged" />
                                <TextBox x:Name="PersonaToneBox" PlaceholderText="例如：毒舌但温柔，吐槽背后是真的关心" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="允许 emoji" Style="{StaticResource CardHeaderStyle}" />
                                    <TextBlock Text="关闭时提示词会明确要求不要使用 emoji。" Style="{StaticResource CardDescriptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" x:Name="PersonaEmojiToggle" VerticalAlignment="Center"
                                              />
                            </Grid>
                        </Border>

                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <Expander.Header>
                                <StackPanel Spacing="2" Padding="0,8">
                                    <TextBlock Text="高级" Style="{StaticResource CardHeaderStyle}" />
                                    <TextBlock Text="系统提示词：模型的核心指令。语气 / emoji / 语言会由上面的设置自动追加，不需要在这里重复。"
                                               Style="{StaticResource CardDescriptionStyle}" />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Spacing="6" Padding="0,8,0,0">
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="系统提示词" Style="{StaticResource CardHeaderStyle}" />
                                        <TextBox x:Name="PersonaSystemPromptBox" AcceptsReturn="True" TextWrapping="Wrap"
                                                 Height="160" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <!-- ================================================ 记忆 -->
                    <StackPanel x:Name="PageMemory" Spacing="6" Visibility="Collapsed">
                        <TextBlock Text="记忆策略" Style="{StaticResource SectionHeaderStyle}" />
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="启用记忆" Style="{StaticResource CardHeaderStyle}" />
                                    <TextBlock Text="关闭后不再记录事件、也不再把记忆送给模型；已有内容保留。" Style="{StaticResource CardDescriptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" x:Name="MemoryEnabledToggle" VerticalAlignment="Center"
                                              />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="保留近期事件" Style="{StaticResource CardHeaderStyle}" />
                                    <TextBlock Text="发送给模型的近期事件条数。" Style="{StaticResource CardDescriptionStyle}" />
                                </StackPanel>
                                <NumberBox Grid.Column="1" x:Name="MemoryRecentEventsBox" Minimum="1" Maximum="100"
                                           MinWidth="120" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="事实上限" Style="{StaticResource CardHeaderStyle}" />
                                    <TextBlock Text="长期偏好（事实）保留的条数；超出时旧的会并入一条「画像」。" Style="{StaticResource CardDescriptionStyle}" />
                                </StackPanel>
                                <NumberBox Grid.Column="1" x:Name="MemoryFactLimitBox" Minimum="1" Maximum="50"
                                           MinWidth="120" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="事件保留天数" Style="{StaticResource CardHeaderStyle}" />
                                    <TextBlock Text="超过这个天数的互动事件会被清理；0 = 永久保留。" Style="{StaticResource CardDescriptionStyle}" />
                                </StackPanel>
                                <NumberBox Grid.Column="1" x:Name="MemoryRetentionBox" Minimum="0" Maximum="3650"
                                           MinWidth="120" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="自动压缩偏好" Style="{StaticResource CardHeaderStyle}" />
                                    <TextBlock Text="偏好超过上限时合并成一条「画像」，而不是丢弃。" Style="{StaticResource CardDescriptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" x:Name="MemoryCompressToggle" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <TextBlock Text="偏好事实" Style="{StaticResource SectionHeaderStyle}" />
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="长期偏好" Style="{StaticResource CardHeaderStyle}" />
                                <TextBlock Text="明确表达过的喜好会记在这里；选中一条可以修改。列表会标出来源（手动 / 对话 / 导入 / 压缩）。"
                                           Style="{StaticResource CardDescriptionStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox x:Name="FactKeyBox" Header="偏好名称" Width="180" />
                                    <TextBox x:Name="FactValueBox" Header="偏好内容" Width="300" />
                                    <Button x:Name="FactSubmitButton" Content="添加事实" Click="OnRememberFactClick"
                                            VerticalAlignment="Bottom" />
                                    <Button x:Name="FactCancelButton" Content="取消编辑" Click="OnCancelFactEditClick"
                                            VerticalAlignment="Bottom" Visibility="Collapsed" />
                                </StackPanel>
                                <ListView x:Name="FactsList" MaxHeight="220" SelectionChanged="OnFactSelectionChanged">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Meta}" Style="{StaticResource CardDescriptionStyle}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="删除选中事实" Click="OnForgetFactClick" />
                                    <Button Content="只清偏好" Click="OnClearFactsClick" />
                                    <Button Content="只清事件" Click="OnClearEventsClick" />
                                    <Button Content="清空这只宠物的记忆" Click="OnClearMemoryClick" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="导出记忆…" Click="OnExportMemoryClick" />
                                    <Button Content="导入记忆…" Click="OnImportMemoryClick" />
                                </StackPanel>
                                <TextBlock Text="记忆只保存在这台电脑上；只有配置了模型服务时，对话与记忆片段才会发送给该服务。"
                                           Style="{StaticResource CardDescriptionStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ============================================ 模型服务 -->
                    <StackPanel x:Name="PageDeepSeek" Spacing="6" Visibility="Collapsed">
                        <TextBlock Text="模型服务" Style="{StaticResource SectionHeaderStyle}" />
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="服务商" Style="{StaticResource CardHeaderStyle}" />
                                    <TextBlock Text="DeepSeek 使用内置地址与参数；自定义适用于任意 OpenAI 兼容端点（不会发送 DeepSeek 专有字段）。"
                                               Style="{StaticResource CardDescriptionStyle}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" x:Name="ProviderCombo" MinWidth="160" VerticalAlignment="Center"
                                          SelectionChanged="OnProviderSelectionChanged" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Base URL" Style="{StaticResource CardHeaderStyle}" />
                                <TextBlock x:Name="DeepSeekBaseUrlHint" Text="DeepSeek 的固定地址；切换到「自定义」后可自行填写。"
                                           Style="{StaticResource CardDescriptionStyle}" />
                                <TextBox x:Name="DeepSeekBaseUrl" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="API Key" Style="{StaticResource CardHeaderStyle}" />
                                <TextBlock Text="保存在 Windows 凭据管理器；也可以改用环境变量（在“高级”里配置变量名）。"
                                           Style="{StaticResource CardDescriptionStyle}" />
                                <PasswordBox x:Name="DeepSeekKeyBox" PlaceholderText="sk-..." />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="保存密钥" Click="OnSaveKeyClick" />
                                    <Button x:Name="ClearKeyButton" Content="清除密钥" Click="OnClearKeyClick" />
                                    <TextBlock x:Name="KeyStatusText" VerticalAlignment="Center" Style="{StaticResource CardDescriptionStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="模型" Style="{StaticResource CardHeaderStyle}" />
                                <TextBlock Text="用于对话与空闲问候的模型名；可以从服务商拉取列表，也可以手动填写。" Style="{StaticResource CardDescriptionStyle}" />
                                <TextBox x:Name="DeepSeekModel" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="拉取模型列表" Click="OnListModelsClick" />
                                    <ComboBox x:Name="ModelCombo" MinWidth="240" Visibility="Collapsed"
                                              PlaceholderText="选择模型" SelectionChanged="OnModelComboChanged" />
                                </StackPanel>
                                <TextBlock x:Name="ModelFetchStatus" Visibility="Collapsed" TextWrapping="Wrap"
                                           Style="{StaticResource CardDescriptionStyle}" />
                            </StackPanel>
                        </Border>

                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <Expander.Header>
                                <StackPanel Spacing="2" Padding="0,8">
                                    <TextBlock Text="高级" Style="{StaticResource CardHeaderStyle}" />
                                    <TextBlock Text="超时、采样参数与思考模式；默认值适用于大多数情况。"
                                               Style="{StaticResource CardDescriptionStyle}" />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Spacing="6" Padding="0,8,0,0">
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="超时（秒）" Style="{StaticResource CardHeaderStyle}" />
                                            <TextBlock Text="单次请求的最长等待时间。" Style="{StaticResource CardDescriptionStyle}" />
                                        </StackPanel>
                                        <NumberBox Grid.Column="1" x:Name="DeepSeekTimeout" Minimum="1" Maximum="600"
                                                   MinWidth="120" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="最大 token" Style="{StaticResource CardHeaderStyle}" />
                                            <TextBlock Text="对话回复的长度上限。" Style="{StaticResource CardDescriptionStyle}" />
                                        </StackPanel>
                                        <NumberBox Grid.Column="1" x:Name="DeepSeekMaxTokens" Minimum="16" Maximum="4000"
                                                   MinWidth="120" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="温度" Style="{StaticResource CardHeaderStyle}" />
                                            <TextBlock Text="越高越随机；0.7 左右比较自然。" Style="{StaticResource CardDescriptionStyle}" />
                                        </StackPanel>
                                        <NumberBox Grid.Column="1" x:Name="DeepSeekTemperature" Minimum="0" Maximum="2"
                                                   SmallChange="0.1" MinWidth="120" VerticalAlignment="Center"
                                                   />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="禁用思考模式" Style="{StaticResource CardHeaderStyle}" />
                                            <TextBlock Text="关闭思考链以缩短延迟，适合短问候。" Style="{StaticResource CardDescriptionStyle}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" x:Name="DeepSeekThinkingDisabled" VerticalAlignment="Center"
                                                      Visibility="Collapsed" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="API Key 环境变量名" Style="{StaticResource CardHeaderStyle}" />
                                        <TextBlock Text="优先使用这个环境变量；为空时默认 DEEPSEEK_API_KEY。" Style="{StaticResource CardDescriptionStyle}" />
                                        <TextBox x:Name="DeepSeekApiKeyEnv" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Expander>

                    </StackPanel>

                    <!-- ================================================ 系统 -->
                    <StackPanel x:Name="PageStartup" Spacing="6" Visibility="Collapsed">
                        <TextBlock Text="启动" Style="{StaticResource SectionHeaderStyle}" />
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="开机自启动" Style="{StaticResource CardHeaderStyle}" />
                                    <TextBlock Text="登录 Windows 后自动启动 Petsona（HKCU Run）。" Style="{StaticResource CardDescriptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" x:Name="AutostartToggle" VerticalAlignment="Center"
                                              Toggled="OnAutostartToggled" />
                            </Grid>
                        </Border>

                        <TextBlock Text="数据" Style="{StaticResource SectionHeaderStyle}" />
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="数据目录" Style="{StaticResource CardHeaderStyle}" />
                                    <TextBlock Text="配置、宠物库、记忆与日志都保存在这里。" Style="{StaticResource CardDescriptionStyle}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="打开" Click="OnOpenDataFolderClick" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="日志目录" Style="{StaticResource CardHeaderStyle}" />
                                    <TextBlock Text="排查问题时的 petsona.log 在这里。" Style="{StaticResource CardDescriptionStyle}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="打开" Click="OnOpenLogFolderClick" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <TextBlock Text="关于" Style="{StaticResource SectionHeaderStyle}" />
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Petsona" Style="{StaticResource CardHeaderStyle}" />
                                <TextBlock x:Name="AboutVersionText" Style="{StaticResource CardDescriptionStyle}" />
                                <TextBlock Text="本地优先的桌宠：宠物、人格与记忆都保存在你自己的机器上，只有配置了 DeepSeek 才会发起网络请求。"
                                           Style="{StaticResource CardDescriptionStyle}" />
                                <Button Content="打开项目主页" Click="OnOpenRepoClick" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </NavigationView>

        <Border Grid.Row="1" Padding="16,8" BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                Background="{ThemeResource LayerFillColorDefaultBrush}">
            <TextBlock x:Name="StatusText" Text="正在加载…" Opacity="0.8" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
