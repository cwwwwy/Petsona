<Window
    x:Class="Petsona.Views.ComposerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Petsona 对话">
    <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="InputBox"
                 Grid.Column="0"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 MinHeight="40"
                 MaxHeight="40"
                 Padding="8,0"
                 BorderThickness="0"
                 Background="Transparent"
                 CornerRadius="0"
                 VerticalContentAlignment="Center"
                 PlaceholderText="和宠物说点什么…"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
        <Button x:Name="SendButton"
                Grid.Column="1"
                Width="40"
                Height="40"
                Margin="8,0,0,0"
                Padding="0"
                CornerRadius="20"
                FontSize="16"
                Content="↑"
                Style="{StaticResource PrimaryButtonStyle}"
                Click="OnSendClick" />
    </Grid>
</Window>
