<Window
    x:Class="Petsona.Views.ComposerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Petsona 对话">
    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBox x:Name="InputBox"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinHeight="120"
                 CornerRadius="4"
                 VerticalContentAlignment="Top"
                 PlaceholderText="和宠物说点什么…" />
        <Grid Grid.Row="1" ColumnSpacing="12" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="Enter 发送 · Shift+Enter 换行 · Esc 关闭"
                       Style="{StaticResource CardDescriptionStyle}" />
            <Button x:Name="SendButton"
                    Grid.Column="1"
                    Content="发送"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="OnSendClick" />
        </Grid>
    </Grid>
</Window>
