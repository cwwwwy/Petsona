{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Petsona",
  "version": "0.1.0",
  "identifier": "com.petsona.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "settings",
        "title": "Petsona 设置",
        "width": 920,
        "height": 600,
        "minWidth": 640,
        "minHeight": 420,
        "resizable": true,
        "center": true,
        "visible": false
      },
      {
        "label": "chat",
        "title": "Petsona 聊天",
        "width": 430,
        "height": 640,
        "minWidth": 360,
        "minHeight": 420,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "26.0"
    }
  }
}
